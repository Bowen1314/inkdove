# 墨鸽 配置。复制成 .env 后填写；不要把真实的 .env 提交到任何地方。
# 本服务只读 INKDOVE_ 开头的变量。

# ---- 必填 ----
# 第一个管理员的邮箱和密码：只在第一次启动、库里还没有任何账号时用来建 admin，之后改这里不影响已有账号
INKDOVE_ADMIN_EMAIL=admin@example.com
# 至少 12 个字符
INKDOVE_ADMIN_PASSWORD=
# cookie 签名密钥，填一段足够长的随机串（如 openssl rand -hex 32）
INKDOVE_SESSION_SECRET=
# WAHA webhook 的 HMAC 密钥（随机串）
INKDOVE_WAHA_WEBHOOK_SECRET=
# WAHA 的 X-Api-Key；docker-compose 会把它同时传给 waha 容器（WAHA_API_KEY）
INKDOVE_WAHA_API_KEY=
# 更新助手（compose 里的 updater 服务）的口令，网页上「立即更新」时用；填一段足够长的随机串（如 openssl rand -hex 32）。
# 不要在线更新的话，删掉 docker-compose.yml 里的 updater 服务，这里留空，网页上会改为显示更新命令
INKDOVE_UPDATER_TOKEN=

# ---- 选填 ----
INKDOVE_PORT=8794
# SQLite 和上传文件目录（compose 里固定为 /app/data）
INKDOVE_DATA_DIR=./data
# 对外访问地址：用于显示 Meta webhook 地址、邀请链接和通知里的后台链接
INKDOVE_PUBLIC_BASE_URL=http://127.0.0.1:8794
# 经 HTTPS 反代对外时设 1
INKDOVE_COOKIE_SECURE=0
# WAHA 地址（compose 里固定为 http://waha:3000）
INKDOVE_WAHA_URL=http://127.0.0.1:3000
# WAHA 回调本服务的地址（compose 里固定为 http://inkdove:8794/webhooks/waha）
INKDOVE_WAHA_WEBHOOK_URL=http://127.0.0.1:8794/webhooks/waha

# 代理中继（上游是 https/socks4/socks5 的号用）：每个号占一个端口，从这里往上分配；只在 compose 内网监听
INKDOVE_PROXY_RELAY_PORT_BASE=18000
# WAHA 连中继用的主机名（compose 里 inkdove 服务的固定 hostname）
INKDOVE_PROXY_RELAY_HOST=inkdove

# 仅第一期升级用：第一期的 WAHA session 名。升级时迁移成「默认号」并沿用这个名字，不用重新扫码。新部署不用填
# INKDOVE_WAHA_SESSION=default

# LLM 初始值：只在第一次启动时写进数据库，之后以设置页为准（接口格式在设置页选）
INKDOVE_LLM_BASE_URL=
INKDOVE_LLM_API_KEY=
INKDOVE_LLM_MODEL=
INKDOVE_LLM_DISTILL_MODEL=
# 设 1 时所有 LLM 调用走确定性的假实现（测试、前端联调用）
INKDOVE_LLM_MOCK=0

# 在线更新：每 6 小时查一次 GitHub 上的最新发布；设 0 关掉（不再访问 GitHub）
INKDOVE_UPDATE_CHECK=1
# 查哪个 GitHub 仓库的发布（owner/repo），镜像名按它推出来：ghcr.io/<小写的 owner/repo>
# INKDOVE_UPDATE_REPO=Bowen1314/inkdove
# 更新助手的地址（compose 内网）
# INKDOVE_UPDATER_URL=http://updater:8080
# 应用镜像的标签，docker-compose.yml 用它拼镜像名。latest 才能在网页上一键升到新版；钉成 0.2.0 这种完整版本号时只提示新版本和命令
# INKDOVE_IMAGE_TAG=latest

# 操作日志保留多少天（默认 365），过期的每天自动清掉
# INKDOVE_AUDIT_RETENTION_DAYS=365

# 仅测试用：Meta Graph API 的根地址，生产不要设
# INKDOVE_META_GRAPH_URL=https://graph.facebook.com
# 仅测试用：Resend 发信接口地址，生产不要设
# INKDOVE_RESEND_API_URL=https://api.resend.com/emails
